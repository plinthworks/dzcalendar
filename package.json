{
  "name": "dzcalendar-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "spike": "node scripts/spikes.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/dom/tsconfig.json --noEmit && tsc -p packages/motion-gsap/tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "node scripts/build.mjs",
    "bench": "node scripts/bench.mjs",
    "build:theme": "sass --no-source-map --style=expanded packages/theme/dzcalendar.scss packages/theme/dzcalendar.css",
    "start": "vite",
    "size": "node scripts/size.mjs",
    "test:browser": "node scripts/browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.10",
    "gsap": "^3.13.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.55.1",
    "sass": "^1.104.1",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^5.9.0",
    "vite": "^6.3.6",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
