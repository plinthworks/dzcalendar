{
  "name": "@dzcalendar/core",
  "version": "1.0.0",
  "description": "Calendar model on Temporal: events with their own time zone, DST-correct days. No DOM, no framework, no Date.",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@tzslot/core": "^2.3.0",
    "@dzcalendar/rrule": "1.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./views": {
      "types": "./src/views.ts",
      "default": "./src/views.ts"
    },
    "./recurrence": {
      "types": "./src/recurrence-entry.ts",
      "default": "./src/recurrence-entry.ts"
    },
    "./live": {
      "types": "./src/live.ts",
      "default": "./src/live.ts"
    }
  },
  "sideEffects": [
    "./src/recurrence-entry.ts"
  ]
}
