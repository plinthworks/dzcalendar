{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "paths": {
      "@dzcalendar/core": ["../core/dist/index.d.ts"],
      "@dzcalendar/dom": ["../dom/dist/index.d.ts"],
      "@dzcalendar/dom/toolkit": ["../dom/dist/toolkit.d.ts"],
      "@dzcalendar/ical": ["../ical/dist/index.d.ts"],
      "@dzcalendar/compat-fullcalendar": ["../compat-fullcalendar/dist/index.d.ts"]
    },
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"]
}
