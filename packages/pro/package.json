{
  "name": "@dzcalendar/pro",
  "version": "0.0.0",
  "description": "DzCalendar Pro: the timeline (resources in rows along an elapsed time axis, a resource area with tree, groups and field columns, windowed in two dimensions), slot capacity, the event and recurrence editor, paged printing and exports (PDF, PNG, XLSX, CSV, ICS) without dependencies. MIT.",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@dzcalendar/core": "0.0.0",
    "@dzcalendar/dom": "0.0.0",
    "@dzcalendar/slots": "0.0.0",
    "@dzcalendar/ical": "0.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./model": {
      "types": "./src/model-entry.ts",
      "default": "./src/model-entry.ts"
    },
    "./slots": {
      "types": "./src/slots-entry.ts",
      "default": "./src/slots-entry.ts"
    },
    "./editor": {
      "types": "./src/editor-entry.ts",
      "default": "./src/editor-entry.ts"
    },
    "./export": {
      "types": "./src/export-entry.ts",
      "default": "./src/export-entry.ts"
    },
    "./print": {
      "types": "./src/print-entry.ts",
      "default": "./src/print-entry.ts"
    }
  },
  "peerDependencies": {
    "@tzslot/dom": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@tzslot/dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tzslot/dom": "^2.2.0"
  }
}
