{
  "name": "@dzcalendar/dom",
  "version": "0.0.0",
  "description": "DzCalendar in plain DOM: views, rendering, interactions. No framework; wrappers sit on top.",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@dzcalendar/core": "0.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./list": {
      "types": "./src/list.ts",
      "default": "./src/list.ts"
    },
    "./multimonth": {
      "types": "./src/multimonth.ts",
      "default": "./src/multimonth.ts"
    },
    "./custom": {
      "types": "./src/custom.ts",
      "default": "./src/custom.ts"
    },
    "./drag": {
      "types": "./src/drag.ts",
      "default": "./src/drag.ts"
    },
    "./toolkit": {
      "types": "./src/toolkit.ts",
      "default": "./src/toolkit.ts"
    },
    "./locales/ar": {
      "types": "./src/locales/ar.ts",
      "default": "./src/locales/ar.ts"
    },
    "./locales/es": {
      "types": "./src/locales/es.ts",
      "default": "./src/locales/es.ts"
    },
    "./locales/de": {
      "types": "./src/locales/de.ts",
      "default": "./src/locales/de.ts"
    }
  }
}
