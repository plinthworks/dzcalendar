      "occurrence|Weekly|2026-10-27T09:00:00+01:00[Europe/Paris]|2026-10-27T10:00:00+01:00[Europe/Paris]",
      "occurrence|Weekly|2026-11-03T09:00:00+01:00[Europe/Paris]|2026-11-03T10:00:00+01:00[Europe/Paris]",
      "occurrence|Weekly|2026-11-10T09:00:00+01:00[Europe/Paris]|2026-11-10T10:00:00+01:00[Europe/Paris]"
    ],
    "series": [
      "FREQ=WEEKLY;COUNT=6|EXDATE=2026-10-20T07:00:00Z"
    ]
  }
