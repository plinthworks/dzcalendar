{
  "id": "normalize-zone-defaulted",
  "suite": "normalize",
  "description": "A wall time with no zone anywhere: display zone, guessed, warned",
  "refs": [],
  "input": {
    "event": {
      "start": "2026-05-01T09:00"
    },
    "context": {
      "displayZone": "Europe/Paris"
    }
  },
  "expected": {
    "ok": true,
    "allDay": false,
    "start": "2026-05-01T09:00:00+02:00[Europe/Paris]",
    "end": "2026-05-01T10:00:00+02:00[Europe/Paris]",
    "warnings": [
      "zone-defaulted"
    ],
    "zoneGuessed": true
  }
}
