{
  "id": "slots-exception-hours",
  "suite": "slots",
  "description": "An exception gives 2026-10-21 its own hours (10:00–12:00), replacing the week's.",
  "refs": [],
  "input": {
    "availability": {
      "timeZone": "Asia/Riyadh",
      "weekly": [
        {
          "days": [
            7,
            1,
            2,
            3,
            4
          ],
          "from": "08:00",
          "to": "12:00"
        }
      ],
      "exceptions": [
        {
          "date": "2026-10-21",
          "windows": [
            {
              "from": "10:00",
              "to": "12:00"
            }
          ]
        }
      ]
    },
    "from": "2026-10-21T00:00+03:00[Asia/Riyadh]",
    "to": "2026-10-22T00:00+03:00[Asia/Riyadh]",
    "duration": 60
  },
  "expected": {
    "slots": [
      "2026-10-21T10:00+03:00/2026-10-21T11:00+03:00",
      "2026-10-21T11:00+03:00/2026-10-21T12:00+03:00"
    ],
    "problems": []
  }
}