{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dzcalendar.dev/conformance/case.schema.json",
  "title": "DzCalendar conformance case",
  "type": "object",
  "required": [
    "id",
    "suite",
    "description",
    "refs",
    "input",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "suite": {
      "enum": [
        "zone-dayinfo",
        "zone-resolve",
        "normalize",
        "time-axis",
        "segment",
        "layout-column",
        "navigation",
        "rrule-expand",
        "series-edit"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": [
        "object",
        "array"
      ]
    },
    "source": {
      "type": "string",
      "description": "Where the expectation comes from when not written by hand: an independent implementation, never ours."
    }
  }
}
