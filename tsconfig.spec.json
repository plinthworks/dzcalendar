{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@dzcalendar/core": [
        "./packages/core/src/index.ts"
      ],
      "@dzcalendar/dom/locales/ar": [
        "./packages/dom/src/locales/ar.ts"
      ],
      "@dzcalendar/dom/locales/es": [
        "./packages/dom/src/locales/es.ts"
      ],
      "@dzcalendar/dom/locales/de": [
        "./packages/dom/src/locales/de.ts"
      ],
      "@dzcalendar/dom/toolkit": [
        "./packages/dom/src/toolkit.ts"
      ],
      "@dzcalendar/dom/custom": [
        "./packages/dom/src/custom.ts"
      ],
      "@dzcalendar/core/views": [
        "./packages/core/src/views.ts"
      ],
      "@dzcalendar/dom/list": [
        "./packages/dom/src/list.ts"
      ],
      "@dzcalendar/dom/multimonth": [
        "./packages/dom/src/multimonth.ts"
      ],
      "@dzcalendar/dom": [
        "./packages/dom/src/index.ts"
      ],
      "@dzcalendar/ical": [
        "./packages/ical/src/index.ts"
      ],
      "@dzcalendar/motion-gsap": [
        "./packages/motion-gsap/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "conformance/**/*.ts",
    "perf/**/*.ts",
    "playground/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
