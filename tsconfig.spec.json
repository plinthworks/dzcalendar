{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["packages/**/*.ts", "conformance/**/*.ts", "perf/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
