            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rrule": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string",
                    "description": "A date, ISO 8601: 2026-10-21.",
                    "examples": [
                      "2026-10-21"
                    ]
                  },
                  "exdates": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "A date, ISO 8601: 2026-10-21.",
                      "examples": [
                        "2026-10-21"
                      ]
                    }
                  },
                  "from": {
                    "$ref": "#/$defs/WallTime"
                  },
                  "to": {
                    "$ref": "#/$defs/WallTime"
                  }
                },
                "required": [
                  "rrule",
                  "start",
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "timeZone"
          ],
          "additionalProperties": false
        },
        "from": {
          "$ref": "#/$defs/Moment"
        },
        "to": {
          "$ref": "#/$defs/Moment"
        },
        "duration": {
          "type": "number",
          "description": "Minutes of real (elapsed) time."
        },
        "step": {
          "type": "number",
          "description": "Minutes between two slot starts, counted from each opening. Default: the duration."
        },
        "bufferBefore": {
          "type": "number",
          "description": "Minutes kept free before and after each appointment (preparation, cleaning)."
        },
        "bufferAfter": {
          "type": "number"
        },
        "minNotice": {
          "type": "number",
          "description": "No slot starting sooner than this many minutes after `now`."
        },
        "maxAdvanceDays": {
          "type": "number",
          "description": "No slot starting later than this many days after `now`."
        },
        "now": {
          "$ref": "#/$defs/Moment"
        },
        "maxPerDay": {
          "type": "number",
          "description": "At most this many bookings starting on one of the provider's dates; a full date offers nothing."
        },
        "busy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "$ref": "#/$defs/Moment"
              },
              "end": {
                "$ref": "#/$defs/Moment"
              },
              "kind": {
                "enum": [
                  "block",
                  "booking"
                ]
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "availability",
        "from",
        "to",
        "duration"
      ],
      "additionalProperties": false
    },
    "TemporalInput": {
      "type": "string",
      "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: A date, ISO 8601: 2026-10-21. Or: A wall time without a zone, read in the event’s or the calendar’s zone: 2026-10-21T09:00. Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
      "examples": [
        "2026-10-21T09:00[Europe/Paris]",
        "2026-10-21",
        "2026-10-21T09:00",
        "2026-10-21T07:00:00Z"
      ]
    },
    "DurationLike": {
      "anyOf": [
        {
          "type": "string",
          "description": "An ISO 8601 duration: PT45M, P1D.",
          "examples": [
            "PT45M"
          ]
        },
        {
          "type": "object",
          "properties": {
            "years": {
              "type": "integer"
            },
            "months": {
              "type": "integer"
            },
            "weeks": {
              "type": "integer"
            },
            "days": {
              "type": "integer"
            },
            "hours": {
              "type": "integer"
            },
            "minutes": {
              "type": "integer"
            },
            "seconds": {
              "type": "integer"
            },
            "milliseconds": {
              "type": "integer"
            },
            "microseconds": {
              "type": "integer"
            },
            "nanoseconds": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "WallTime": {
      "type": "string",
      "description": "A wall time of day, HH:mm: 08:30 (24:00 as an end is the next midnight).",
      "examples": [
        "08:30"
      ]
    },
    "Moment": {
      "type": "string",
      "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
      "examples": [
        "2026-10-21T09:00[Europe/Paris]",
        "2026-10-21T07:00:00Z"
      ]
    }
  }
}
