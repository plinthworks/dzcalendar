{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/plinthworks/dzcalendar/main/site/commands.schema.json",
  "title": "DzCalendar commands",
  "description": "What an assistant can ask a DzCalendar to do (calendar.run(command)), an event, and a slot query (findSlots). Dates and times are ISO 8601 strings with IANA zones; nothing here is a JS Date. Generated from the TypeScript types by scripts/gen-schema.mjs.",
  "$ref": "#/$defs/Command",
  "$defs": {
    "Command": {
      "description": "What a person or a program asks the calendar to do — plain data, so it can be logged, sent over a wire, or emitted by an assistant (`commands.schema.json` describes them). `event.create` with an `rrule` creates a series.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event.create"
            },
            "event": {
              "$ref": "#/$defs/EventInput"
            }
          },
          "required": [
            "type",
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event.update"
            },
            "id": {
              "type": "string"
            },
            "patch": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "start": {
                  "type": "string",
                  "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: A date, ISO 8601: 2026-10-21. Or: A wall time without a zone, read in the event’s or the calendar’s zone: 2026-10-21T09:00. Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
                  "examples": [
                    "2026-10-21T09:00[Europe/Paris]",
                    "2026-10-21",
                    "2026-10-21T09:00",
                    "2026-10-21T07:00:00Z"
                  ]
                },
                "duration": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "An ISO 8601 duration: PT45M, P1D.",
                      "examples": [
                        "PT45M"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "years": {
                          "type": "number"
                        },
                        "months": {
                          "type": "number"
                        },
                        "weeks": {
                          "type": "number"
                        },
                        "days": {
                          "type": "number"
                        },
                        "hours": {
                          "type": "number"
                        },
                        "minutes": {
                          "type": "number"
                        },
                        "seconds": {
                          "type": "number"
                        },
                        "milliseconds": {
                          "type": "number"
                        },
                        "microseconds": {
                          "type": "number"
                        },
                        "nanoseconds": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "Used when `end` is absent. Days are wall days, hours are elapsed hours (`ZonedDateTime.add`)."
                },
                "allDay": {
                  "type": "boolean"
                },
                "timeZone": {
                  "type": "string",
                  "description": "The event's own zone, for a start that does not carry one."
                },
                "resourceId": {
                  "type": "string"
                },
                "resourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "seriesId": {
                  "type": "string",
                  "description": "With `recurrenceId`, the event replaces one occurrence of the series `seriesId` (iCalendar's RECURRENCE-ID): the occurrence that *would have* started then. Linked when the series comes in the same batch."
                },
                "recurrenceId": {
                  "type": "string",
                  "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: A date, ISO 8601: 2026-10-21. Or: A wall time without a zone, read in the event’s or the calendar’s zone: 2026-10-21T09:00. Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
                  "examples": [
                    "2026-10-21T09:00[Europe/Paris]",
                    "2026-10-21",
                    "2026-10-21T09:00",
                    "2026-10-21T07:00:00Z"
                  ]
                },
                "display": {
                  "enum": [
                    "auto",
                    "block",
                    "list-item",
                    "background",
                    "inverse-background",
                    "none"
                  ]
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "tentative",
                    "cancelled"
                  ]
                },
                "busy": {
                  "type": "boolean",
                  "description": "Feeds the slot engine: a busy event blocks availability. Default: not cancelled."
                },
                "editable": {
                  "type": "boolean"
                },
                "startEditable": {
                  "type": "boolean"
                },
                "durationEditable": {
                  "type": "boolean"
                },
                "resourceEditable": {
                  "type": "boolean"
                },
                "classNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "extendedProps": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                },
                "groupId": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "end": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: A date, ISO 8601: 2026-10-21. Or: A wall time without a zone, read in the event’s or the calendar’s zone: 2026-10-21T09:00. Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
                      "examples": [
                        "2026-10-21T09:00[Europe/Paris]",
                        "2026-10-21",
                        "2026-10-21T09:00",
                        "2026-10-21T07:00:00Z"
                      ]
                    }
                  ]
                },
                "tone": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "scope": {
              "enum": [
                "this",
                "following",
                "all"
              ]
            },
            "key": {
              "type": "string",
              "description": "The occurrence's original start, when `id` is the series': as the series writes it (`2026-10-21T08:00:00+02:00[Europe/Paris]`, a date for an all-day series), or the wall time without its offset (`2026-10-21T08:00[Europe/Paris]`), or an instant."
            }
          },
          "required": [
            "type",
            "id",
            "patch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event.move"
            },
            "id": {
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/TemporalInput"
            },
            "end": {
              "$ref": "#/$defs/TemporalInput"
            },
            "resourceIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scope": {
              "enum": [
                "this",
                "following",
                "all"
              ]
            },
            "key": {
              "type": "string",
              "description": "The occurrence's original start, when `id` is the series': as the series writes it (`2026-10-21T08:00:00+02:00[Europe/Paris]`, a date for an all-day series), or the wall time without its offset (`2026-10-21T08:00[Europe/Paris]`), or an instant."
            }
          },
          "required": [
            "type",
            "id",
            "start"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event.resize"
            },
            "id": {
              "type": "string"
            },
            "edge": {
              "enum": [
                "start",
                "end"
              ]
            },
            "to": {
              "$ref": "#/$defs/TemporalInput"
            },
            "scope": {
              "enum": [
                "this",
                "following",
                "all"
              ]
            },
            "key": {
              "type": "string",
              "description": "The occurrence's original start, when `id` is the series': as the series writes it (`2026-10-21T08:00:00+02:00[Europe/Paris]`, a date for an all-day series), or the wall time without its offset (`2026-10-21T08:00[Europe/Paris]`), or an instant."
            }
          },
          "required": [
            "type",
            "id",
            "edge",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event.delete"
            },
            "id": {
              "type": "string"
            },
            "scope": {
              "enum": [
                "this",
                "following",
                "all"
              ]
            },
            "key": {
              "type": "string",
              "description": "The occurrence's original start, when `id` is the series': as the series writes it (`2026-10-21T08:00:00+02:00[Europe/Paris]`, a date for an all-day series), or the wall time without its offset (`2026-10-21T08:00[Europe/Paris]`), or an instant."
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "series.delete"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "series.split"
            },
            "id": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "patch": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "start": {
                  "type": "string",
                  "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: A date, ISO 8601: 2026-10-21. Or: A wall time without a zone, read in the event’s or the calendar’s zone: 2026-10-21T09:00. Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
                  "examples": [
                    "2026-10-21T09:00[Europe/Paris]",
                    "2026-10-21",
                    "2026-10-21T09:00",
                    "2026-10-21T07:00:00Z"
                  ]
                },
                "duration": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "An ISO 8601 duration: PT45M, P1D.",
                      "examples": [
                        "PT45M"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "years": {
                          "type": "number"
                        },
                        "months": {
                          "type": "number"
                        },
                        "weeks": {
                          "type": "number"
                        },
                        "days": {
                          "type": "number"
                        },
                        "hours": {
                          "type": "number"
                        },
                        "minutes": {
                          "type": "number"
                        },
                        "seconds": {
                          "type": "number"
                        },
                        "milliseconds": {
                          "type": "number"
                        },
                        "microseconds": {
                          "type": "number"
                        },
                        "nanoseconds": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "Used when `end` is absent. Days are wall days, hours are elapsed hours (`ZonedDateTime.add`)."
                },
                "allDay": {
                  "type": "boolean"
                },
                "timeZone": {
                  "type": "string",
                  "description": "The event's own zone, for a start that does not carry one."
                },
                "resourceId": {
                  "type": "string"
                },
                "resourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "seriesId": {
                  "type": "string",
                  "description": "With `recurrenceId`, the event replaces one occurrence of the series `seriesId` (iCalendar's RECURRENCE-ID): the occurrence that *would have* started then. Linked when the series comes in the same batch."
                },
                "recurrenceId": {
                  "type": "string",
                  "description": "A wall time in a zone, ISO 8601 with the IANA name: 2026-10-21T09:00[Europe/Paris] (an offset may be given: 2026-10-21T09:00+02:00[Europe/Paris]). Or: A date, ISO 8601: 2026-10-21. Or: A wall time without a zone, read in the event’s or the calendar’s zone: 2026-10-21T09:00. Or: An instant, ISO 8601 in UTC or with an offset: 2026-10-21T07:00:00Z.",
                  "examples": [
                    "2026-10-21T09:00[Europe/Paris]",
                    "2026-10-21",
                    "2026-10-21T09:00",
                    "2026-10-21T07:00:00Z"
                  ]
                },
                "display": {
                  "enum": [
                    "auto",
                    "block",
                    "list-item",
                    "background",
                    "inverse-background",
                    "none"
                  ]
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "tentative",
                    "cancelled"
                  ]
                },
                "busy": {
                  "type": "boolean",
                  "description": "Feeds the slot engine: a busy event blocks availability. Default: not cancelled."
                },
                "editable": {
                  "type": "boolean"
                },
                "startEditable": {
                  "type": "boolean"
                },
                "durationEditable": {
                  "type": "boolean"
                },
                "resourceEditable": {
