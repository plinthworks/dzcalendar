    "EventInput": {
      "description": "An event as an application hands it in: loose, partly optional, strings welcome. `normalizeEvent` turns it into a `CalEvent` or says why it cannot. With `rrule` (and optionally `exdate`, `rdate`) it becomes a series: its start is the first occurrence, its length every occurrence's length.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/TemporalInput"
        },
        "end": {
          "$ref": "#/$defs/TemporalInput"
        },
        "duration": {
          "$ref": "#/$defs/DurationLike"
        },
        "allDay": {
          "type": "boolean"
        },
        "timeZone": {
          "type": "string",
          "description": "The event's own zone, for a start that does not carry one."
        },
        "resourceId": {
          "type": "string"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rrule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "An RFC 5545 rule (`FREQ=WEEKLY;BYDAY=MO`), or several: the event becomes a series."
        },
        "exdate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemporalInput"
          }
        },
        "rdate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemporalInput"
          }
        },
        "seriesId": {
          "type": "string",
          "description": "With `recurrenceId`, the event replaces one occurrence of the series `seriesId` (iCalendar's RECURRENCE-ID): the occurrence that *would have* started then. Linked when the series comes in the same batch."
        },
        "recurrenceId": {
          "$ref": "#/$defs/TemporalInput"
        },
        "display": {
          "enum": [
            "auto",
            "block",
            "list-item",
            "background",
            "inverse-background",
            "none"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "tentative",
            "cancelled"
          ]
        },
        "busy": {
          "type": "boolean",
          "description": "Feeds the slot engine: a busy event blocks availability. Default: not cancelled."
        },
        "editable": {
          "type": "boolean"
        },
        "startEditable": {
          "type": "boolean"
        },
        "durationEditable": {
          "type": "boolean"
        },
        "resourceEditable": {
          "type": "boolean"
        },
        "classNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "type": "string",
          "description": "A tone, not a colour (`--dz-tone-<tone>`): `blue`, `green`, `red`, `amber`, `violet`, `slate` in the themes shipped, or one an application defines."
        },
        "url": {
          "type": "string"
        },
        "extendedProps": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "start"
      ]
    },
    "SlotQuery": {
      "type": "object",
      "properties": {
        "availability": {
          "type": "object",
          "properties": {
            "timeZone": {
              "type": "string"
            },
            "weekly": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "array",
